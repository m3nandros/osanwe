# ==========================================
# Osanwe Configuration Environment Variables
# ==========================================

# --- OpenAI LLM Configuration (Required) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=128000

# --- Compiler & Autonomous Auto-Repair Loop ---
MAX_COMPILATION_ITERATIONS=10
ENABLE_SURGICAL_FIXER=true
SURGICAL_FIXER_MODEL=gpt-4o-mini
SURGICAL_FIXER_TEMPERATURE=0.0

# --- Paths & Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs
DOWNLOAD_DIR=./downloads
TEMP_DIR=./temp
OUTPUT_DIR=./output
GLOSSARY_PATH=./glossary.json

# --- Discord Bot Integration (Optional) ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# --- Notion Workspace Integration (Optional) ---
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# --- S3 Storage for Large PDF Bundles (Optional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
