\documentclass[11pt]{article}

\usepackage{fontspec}
\usepackage{iftex}
\providecommand{\DeclareUnicodeCharacter}[2]{}
\usepackage{polyglossia}
\setdefaultlanguage{$if(lang)$$lang$$else$russian$endif$}
$if(rosetta_is_ru)$
\setotherlanguage{english}
\renewcommand{\figurename}{Рис.}
\renewcommand{\tablename}{Таблица}
$endif$

\IfFileExists{geometry.sty}{\usepackage[margin=1in]{geometry}}{}
\IfFileExists{microtype.sty}{\usepackage{microtype}}{}

\defaultfontfeatures{Ligatures=TeX}
\IfFontExistsTF{TeX Gyre Termes}{\setmainfont{TeX Gyre Termes}}{\setmainfont{Times New Roman}}
\IfFontExistsTF{TeX Gyre Heros}{\setsansfont{TeX Gyre Heros}}{\setsansfont{Arial}}
\IfFontExistsTF{TeX Gyre Cursor}{\setmonofont{TeX Gyre Cursor}}{\setmonofont{Courier New}}

\IfFontExistsTF{TeX Gyre Termes}{\newfontfamily\cyrillicfont{TeX Gyre Termes}}{\newfontfamily\cyrillicfont{Times New Roman}}
\IfFontExistsTF{TeX Gyre Heros}{\newfontfamily\cyrillicfontsf{TeX Gyre Heros}}{\newfontfamily\cyrillicfontsf{Arial}}
\IfFontExistsTF{TeX Gyre Cursor}{\newfontfamily\cyrillicfonttt{TeX Gyre Cursor}}{\newfontfamily\cyrillicfonttt{Courier New}}
\usepackage{graphicx}
\makeatletter
\def\maxwidth{0.67\linewidth}
\def\maxheight{\ifdim\Gin@nat@height>0.55\textheight 0.55\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{array}
\IfFileExists{calc.sty}{\usepackage{calc}}{}
\usepackage{tabularx}
\usepackage{multirow}
\usepackage{makecell}
\renewcommand{\arraystretch}{1.15}
\setlength{\tabcolsep}{4pt}
\usepackage{amsmath}
\usepackage{amssymb}
\IfFileExists{unicode-math.sty}{\usepackage{unicode-math}\IfFontExistsTF{Latin Modern Math}{\setmathfont{Latin Modern Math}}{}}{}
\IfFileExists{stmaryrd.sty}{\usepackage{stmaryrd}}{\providecommand{\llbracket}{[}\providecommand{\rrbracket}{]}}
\usepackage{xcolor}
\IfFileExists{colortbl.sty}{\usepackage{colortbl}}{}
\usepackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=blue,urlcolor=blue,citecolor=blue}

\setcounter{secnumdepth}{3}

\makeatletter
\@ifundefined{c@none}{\newcounter{none}}{}
\makeatother

\setlength{\parindent}{1.2em}
\setlength{\parskip}{0pt}
\emergencystretch=2em

\setlength{\textfloatsep}{12pt}
\setlength{\intextsep}{10pt}
\setlength{\abovecaptionskip}{6pt}
\setlength{\belowcaptionskip}{6pt}

\IfFileExists{caption.sty}{\usepackage[font=small,labelfont=bf,labelsep=period,justification=raggedright,singlelinecheck=false]{caption}}{}
\IfFileExists{capt-of.sty}{\usepackage{capt-of}}{}
\IfFileExists{float.sty}{\usepackage{float}\floatplacement{figure}{htbp}}{}
\IfFileExists{enumitem.sty}{\usepackage{enumitem}\setlist[itemize]{leftmargin=2em}}{}

\IfFileExists{etoolbox.sty}{\usepackage{etoolbox}\AtBeginEnvironment{longtable}{\small\setlength{\tabcolsep}{1.5pt}}\AtBeginEnvironment{figure}{\centering}\AtBeginEnvironment{table}{\centering}}{}

\providecommand{\tightlist}{}
\providecommand{\pandocbounded}[1]{{\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}#1}}

\newcommand{\rosettaFitToken}[1]{\begingroup\setbox0=\hbox{\strut #1}\ifdim\wd0>\hsize\resizebox{\hsize}{!}{#1}\else#1\fi\endgroup}

\let\rosettaoldin\in
\renewcommand{\in}{\ensuremath{\rosettaoldin}}

\IfFileExists{newunicodechar.sty}{
\usepackage{newunicodechar}
\newunicodechar{⊢}{\ensuremath{\vdash}}
\newunicodechar{⇒}{\ensuremath{\Rightarrow}}
\newunicodechar{‑}{-}
\newunicodechar{⎡}{[}
\newunicodechar{⎤}{]}
\newunicodechar{〈}{\ensuremath{\langle}}
\newunicodechar{〉}{\ensuremath{\rangle}}
\newunicodechar{⟦}{\ensuremath{\llbracket}}
\newunicodechar{⟧}{\ensuremath{\rrbracket}}
}{}

\title{$title$}
\author{$for(author)$$author$$sep$\\$endfor$}
\date{$date$}

\begin{document}
$if(title)$\maketitle$endif$

$if(abstract)$
\begin{abstract}
\normalfont
$abstract$
\end{abstract}
$endif$

$body$

\end{document}
